{"file":"Refund.dc.html","data":"<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Refund Policy — Zendt</title>\n<meta name=\"description\" content=\"Zendt refund policy for paid subscriptions.\">\n<link rel=\"icon\" href=\"/logo-transparent.png\" type=\"image/png\">\n<script src=\"/support.js\"></script>\n</head>\n<body>\n<x-dc>\n<helmet>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap\">\n  <style>\n    body { margin: 0; background: #0A0A0A; }\n    a { color: inherit; text-decoration: none; }\n    a:hover { opacity: 0.75; }\n  </style>\n</helmet>\n\n<div style=\"background:#0A0A0A; color:#F5F5F5; font-family:'Cairo',sans-serif; min-height:100vh;\">\n  <nav style=\"display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; padding:16px clamp(20px,5vw,48px); border-bottom:1px solid rgba(255,255,255,0.08);\">\n    <a href=\"/\" style=\"display:flex; align-items:center; gap:9px; font-family:'Clash Display',sans-serif; font-weight:600; font-size:20px; letter-spacing:-0.02em;\">\n      <img src=\"/logo-transparent.png\" alt=\"Zendt\" style=\"width:34px; height:34px; display:block; object-fit:contain;\">\n      Zendt\n    </a>\n    <a href=\"/\" style=\"font-size:14px; color:rgba(255,255,255,0.6); font-weight:500;\">← Back to home</a>\n  </nav>\n\n  <main style=\"max-width:760px; margin:0 auto; padding:clamp(48px,10vw,80px) clamp(16px,4vw,24px) 100px;\">\n    <div style=\"font-family:'Cairo',sans-serif; font-size:12px; color:rgba(255,255,255,0.4); letter-spacing:0.08em; text-transform:uppercase; margin-bottom:16px;\">Legal</div>\n    <h1 style=\"font-family:'Clash Display',sans-serif; font-size:38px; font-weight:800; letter-spacing:-0.02em; margin:0 0 12px;\">Refund Policy</h1>\n    \n    <div style=\"display:flex; flex-direction:column; gap:36px; font-size:15px; line-height:1.75; color:rgba(255,255,255,0.7);\">\n      <section>\n        <h2 style=\"font-family:'Clash Display',sans-serif; font-size:19px; font-weight:700; color:#F5F5F5; margin:0 0 10px;\">1. Scope</h2>\n        <p style=\"margin:0;\">This policy covers refunds for paid subscriptions to the Zendt software. It does not apply to funds, invoices, or transactions between you and your own clients — Zendt is invoicing and tracking software, and has no role in your client relationships beyond providing the tool.</p>\n      </section>\n      <section>\n        <h2 style=\"font-family:'Clash Display',sans-serif; font-size:19px; font-weight:700; color:#F5F5F5; margin:0 0 10px;\">2. Subscription Refunds</h2>\n        <p style=\"margin:0;\">If you're unsatisfied with a paid Zendt subscription, contact us within 7 days of the charge and we'll review your request. Eligible requests are typically refunded to the original payment method within 7–10 business days.</p>\n      </section>\n      <section>\n        <h2 style=\"font-family:'Clash Display',sans-serif; font-size:19px; font-weight:700; color:#F5F5F5; margin:0 0 10px;\">3. Cancellations</h2>\n        <p style=\"margin:0;\">You can cancel your subscription at any time from your account settings. Cancelling stops future billing at the end of your current billing period; we don't provide prorated refunds for partial periods unless required by law.</p>\n      </section>\n      <section>\n        <h2 style=\"font-family:'Clash Display',sans-serif; font-size:19px; font-weight:700; color:#F5F5F5; margin:0 0 10px;\">4. Non-Refundable Situations</h2>\n        <p style=\"margin:0;\">We generally don't issue refunds for subscription periods already substantially used, or for dissatisfaction unrelated to the functioning of the software itself.</p>\n      </section>\n      <section>\n        <h2 style=\"font-family:'Clash Display',sans-serif; font-size:19px; font-weight:700; color:#F5F5F5; margin:0 0 10px;\">5. How to Request a Refund</h2>\n        <p style=\"margin:0;\">Email <a href=\"mailto:hello@zendt.in\" style=\"color:#F5F5F5; text-decoration:underline;\">hello@zendt.in</a> with your account details and the reason for your request. We aim to respond within 2 business days.</p>\n      </section>\n      <section>\n        <h2 style=\"font-family:'Clash Display',sans-serif; font-size:19px; font-weight:700; color:#F5F5F5; margin:0 0 10px;\">6. Changes to This Policy</h2>\n        <p style=\"margin:0;\">We may update this Refund Policy from time to time. Changes will be posted here with a new \"Last updated\" date.</p>\n      </section>\n    </div>\n  </main>\n\n  <footer style=\"padding:32px clamp(20px,5vw,48px); border-top:1px solid rgba(255,255,255,0.08); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;\">\n    <span style=\"font-size:13px; color:rgba(255,255,255,0.4);\">© 2026 Zendt</span>\n    <div style=\"display:flex; gap:20px;\">\n      <a href=\"/terms\" style=\"font-size:13px; color:rgba(255,255,255,0.4);\">Terms</a>\n      <a href=\"/privacy\" style=\"font-size:13px; color:rgba(255,255,255,0.4);\">Privacy</a>\n      <a href=\"/refund\" style=\"font-size:13px; color:rgba(255,255,255,0.6);\">Refund</a>\n    </div>\n  </footer>\n</div>\n\n</x-dc>\n</body>\n</html>\n"}